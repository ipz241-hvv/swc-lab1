<Window x:Class="ProcessManagerWpfApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер процесів" Height="450" Width="800">
    <Grid Margin="10,10,10,13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding ProgramButtonInfos}" DockPanel.Dock="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" 
                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                            CommandParameter="{Binding Path}"
                            Width="100" Margin="0,0,5,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Оновити" 
                Command="{Binding RefreshCommand}" 
                Width="120" DockPanel.Dock="Right" Background="#F0F0F0"/>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10"
                  ItemsSource="{Binding Processes}"
                  SelectedItem="{Binding SelectedProcess}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="60" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Назва" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Пам'ять (MB)" Width="100" Binding="{Binding MemoryMb}"/>
                <DataGridTextColumn Header="Старт" Width="170" Binding="{Binding StartTime}"/>
                <DataGridTextColumn Header="Пріоритет" Width="110" Binding="{Binding Priority}"/>
                <DataGridTextColumn Header="Потоків" Width="70" Binding="{Binding Threads}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Label Content="Пріоритет:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Width="130"
                Margin="0,0,10,0"
                ItemsSource="{Binding PriorityList}"
                SelectedItem="{Binding SelectedPriority, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Змінити пріоритет" Width="140" Margin="0,0,10,0" Command="{Binding SetPriorityCommand}"/>
            <Button Content="Завершити процес" Width="140" Command="{Binding KillCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Label Content="Грень Вадим, ІПЗ-24-1" Margin="0,10,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
